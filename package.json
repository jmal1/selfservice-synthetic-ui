{
  "name": "selfservice-synthetic-ui",
  "version": "0.1.0",
  "private": true,
  "description": "External Playwright synthetic-monitoring suite for the Crucible self-service portal",
  "scripts": {
    "test": "playwright test",
    "test:ui-mode": "playwright test --ui",
    "test:no-push": "PUSHGATEWAY_URL=skip playwright test",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
