{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"]
	},
	"include": [
		"tests/**/*.ts",
		"unit-tests/**/*.ts",
		"playwright.config.ts",
		"playwright.unit.config.ts"
	]
}
