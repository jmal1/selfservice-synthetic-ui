[Unit]
Description=Crucible synthetic UI monitor (Playwright in Docker)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=jmal
Group=docker
WorkingDirectory=/opt/synthetic-ui/app
# Provisioning maintenance mode: safe browser checks continue, while the
# create/destroy lifecycle check is not registered. Do not change these until
# the coordinated API/UI rollout is complete and provisioning is approved.
Environment=SYNTHETIC_LIFECYCLE_ENABLED=false
Environment=SYNTHETIC_EXPECT_MAINTENANCE=true
# Pull the latest image (small layer diff once cached) then run once.
ExecStartPre=/usr/bin/docker compose -f /opt/synthetic-ui/app/deploy/docker-compose.yml pull --quiet
ExecStart=/usr/bin/docker compose -f /opt/synthetic-ui/app/deploy/docker-compose.yml run --rm monitor
StandardOutput=journal
StandardError=journal
# Each run should complete in ~3 min; kill after 15 to avoid runaway.
TimeoutStartSec=900

# Security hardening (the container itself adds another layer of isolation).
NoNewPrivileges=false
PrivateTmp=true
